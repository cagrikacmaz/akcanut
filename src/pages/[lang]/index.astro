---
// Pages for every language except English (which lives at the site root).
import HomePage from '../../components/HomePage.astro';
import { availableLocales, defaultLocale, type Locale } from '../../i18n';

export function getStaticPaths() {
  return availableLocales.filter((lang) => lang !== defaultLocale).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
---

<HomePage locale={lang} />
