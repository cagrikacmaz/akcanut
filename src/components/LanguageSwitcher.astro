---
// Footer language links, each in its own name. The header uses LanguageMenu instead.
import { availableLocales, getDictionary, languageNames, localePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

{
  availableLocales.length > 1 && (
    <nav class="lang-links" aria-label={t.a11y.languages}>
      <ul>
        {availableLocales.map((l) => (
          <li>
            <a href={localePath(l)} hreflang={l} lang={l} aria-current={l === locale ? 'true' : undefined} data-lang-link>
              {languageNames[l]}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .lang-links ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lang-links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.9375rem;
    color: var(--ink-soft);
    text-decoration: none;
  }

  .lang-links a:hover {
    text-decoration: underline;
  }

  .lang-links a[aria-current='true'] {
    color: var(--deep);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--brown);
    text-underline-offset: 0.35em;
  }
</style>
