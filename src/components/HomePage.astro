---
// The one-page site, shared by every language: src/pages/index.astro, tr/, sw/.
import Base from '../layouts/Base.astro';
import type { Locale } from '../i18n';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Journey from './journey/Journey.astro';
import Origin from './Origin.astro';
import Product from './Product.astro';
import Quality from './Quality.astro';
import Trade from './Trade.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<Base locale={locale}>
  <Header locale={locale} />
  <main id="main" tabindex="-1">
    <Hero locale={locale} />
    <Journey locale={locale} />
    <Origin locale={locale} />
    <Product locale={locale} />
    <Quality locale={locale} />
    <Trade locale={locale} />
    <Contact locale={locale} />
  </main>
  <Footer locale={locale} />
</Base>
