---
import { Image } from 'astro:assets';
import icon from '../assets/brand/akcanut-icon.png';
import { getDictionary, localePath, type Locale } from '../i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const home = localePath(locale);
const links = [
  ['journey', t.nav.journey],
  ['origin', t.nav.origin],
  ['product', t.nav.product],
  ['quality', t.nav.quality],
  ['trade', t.nav.trade],
  ['contact', t.nav.contact],
] as const;
---

<header class="site-header" id="top">
  <div class="site-header__inner container">
    <a class="brand" href={home} aria-label={t.a11y.homeLink}>
      <Image src={icon} alt="" width={32} height={32} densities={[1.5, 2, 3]} loading="eager" class="brand__icon" />
      <span class="brand__name" aria-hidden="true">AKCANUT</span>
    </a>

    <nav class="site-nav" aria-label={t.a11y.mainNav} data-nav>
      <button
        class="site-nav__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav-list"
        data-nav-toggle
        data-label-open={t.a11y.menuOpen}
        data-label-close={t.a11y.menuClose}
      >
        <span class="site-nav__bars" aria-hidden="true"></span>
        <span data-nav-label>{t.a11y.menuOpen}</span>
      </button>
      <ul class="site-nav__list" id="site-nav-list">
        {
          links.map(([id, label]) => (
            <li>
              <a href={`${home}#${id}`}>{label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <LanguageSwitcher locale={locale} />
  </div>
</header>

<script>
  import '../scripts/menu';
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--line-soft);
    background: var(--paper);
  }

  .site-header__inner {
    position: relative;
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 2rem);
    height: var(--header-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-right: auto;
    color: var(--deep);
    text-decoration: none;
  }

  .brand__icon {
    width: 32px;
    height: 32px;
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    line-height: 1;
  }

  .site-nav__list {
    display: flex;
    gap: clamp(1rem, 1.8vw, 2rem);
  }

  .site-nav__list a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--ink);
    text-decoration: none;
  }

  .site-nav__list a:hover {
    color: var(--brown);
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .site-nav__toggle {
    display: none;
  }

  @media (max-width: 59.99rem) {
    :global(.js) .site-nav__toggle {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      min-height: 2.75rem;
      padding: 0 0.25rem;
      border: 0;
      background: none;
      font-size: 0.9rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      color: var(--deep);
      cursor: pointer;
    }

    .site-nav__bars,
    .site-nav__bars::before {
      display: block;
      width: 18px;
      height: 1.5px;
      background: currentColor;
      transition: transform 0.2s var(--ease);
    }

    .site-nav__bars {
      position: relative;
      transform: translateY(-3px);
    }

    .site-nav__bars::before {
      content: '';
      position: absolute;
      top: 6px;
    }

    [aria-expanded='true'] .site-nav__bars {
      transform: translateY(0) rotate(45deg);
    }

    [aria-expanded='true'] .site-nav__bars::before {
      top: 0;
      transform: rotate(-90deg);
    }

    :global(.js) .site-nav__list {
      position: absolute;
      top: 100%;
      left: calc(-1 * var(--gutter));
      right: calc(-1 * var(--gutter));
      display: none;
      flex-direction: column;
      gap: 0;
      padding: 0.5rem var(--gutter) 1.25rem;
      border-bottom: 1px solid var(--line);
      background: var(--paper);
      box-shadow: 0 18px 30px -24px rgb(6 51 33 / 0.35);
    }

    :global(.js) .site-nav.is-open .site-nav__list {
      display: flex;
    }

    :global(.js) .site-nav__list a {
      width: 100%;
      min-height: 3rem;
      border-bottom: 1px solid var(--line-soft);
      font-size: 1rem;
    }

    /* Without JavaScript the links wrap under the brand, so the header scrolls away. */
    :global(.no-js) .site-header {
      position: static;
    }

    :global(.no-js) .site-header__inner {
      flex-wrap: wrap;
      height: auto;
      padding-block: 0.5rem;
    }

    :global(.no-js) .site-nav__list {
      flex-wrap: wrap;
      gap: 0 1rem;
    }
  }
</style>
