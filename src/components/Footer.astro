---
import { Image } from 'astro:assets';
import icon from '../assets/brand/akcanut-icon.png';
import { photoCredits } from '../data/photo-credits';
import { fill, getDictionary, type Locale } from '../i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const year = new Date().getFullYear();

// "A, B, C and D" in the page language, with each name linking to its photo.
const names = photoCredits.map((c) => c.photographer);
// British English lists have no comma before "and".
const listLocale = locale === 'en' ? 'en-GB' : locale;
const nameParts = new Intl.ListFormat(listLocale, { type: 'conjunction' }).formatToParts(names);
const [creditsBefore, creditsAfter] = t.footer.photoCredits.split('{names}');
const urlFor = (name: string) => photoCredits.find((c) => c.photographer === name)?.url;
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <Image src={icon} alt="" width={56} height={56} densities={[1.5, 2, 3]} class="site-footer__icon" />
      <div>
        <p class="site-footer__name">AKCANUT</p>
        <p class="site-footer__tagline">{t.footer.tagline}</p>
      </div>
    </div>
    <LanguageSwitcher locale={locale} />
    <div class="site-footer__meta">
      <p>{fill(t.footer.copyright, { year })}</p>
      <a href="#top">{t.footer.backToTop}</a>
    </div>
    <p class="site-footer__credits">
      {creditsBefore}
      {
        nameParts.map((part) =>
          part.type === 'element' ? (
            <a href={urlFor(part.value)} target="_blank" rel="noopener noreferrer">{part.value}</a>
          ) : (
            part.value
          ),
        )
      }
      {creditsAfter}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: clamp(3rem, 2rem + 3vw, 4.5rem);
    border-top: 1px solid var(--line);
    background: var(--paper-deep);
    font-size: 0.9375rem;
  }

  .site-footer__inner {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  .site-footer__brand {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .site-footer__icon {
    width: 56px;
    height: 56px;
  }

  .site-footer__name {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    line-height: 1.1;
    color: var(--deep);
  }

  .site-footer__tagline {
    color: var(--ink-soft);
  }

  .site-footer__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    color: var(--ink-soft);
  }

  .site-footer__meta a {
    color: var(--ink);
  }

  .site-footer__credits {
    grid-column: 1 / -1;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }

  .site-footer__credits a {
    color: var(--ink-soft);
  }

  @media (min-width: 48rem) {
    .site-footer__inner {
      grid-template-columns: 1fr auto auto;
      gap: 2.5rem;
    }
  }
</style>
