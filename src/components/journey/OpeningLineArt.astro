---
// Line art of the hills and the two sea waves, traced from the icon (scripts/trace-line-art.mjs).
// It is an illustration only: the real icon image fades in over it.
import art from './line-art.json';
---

<svg class="lineart" viewBox={`0 0 ${art.width} ${art.height}`} aria-hidden="true" focusable="false">
  {art.hills.map((d, i) => <path class="lineart__hill" d={d} pathLength="1" style={`--i: ${i}`} />)}
  {art.waves.map((d, i) => <path class="lineart__wave" d={d} pathLength="1" style={`--i: ${i}`} />)}
</svg>

<style>
  .lineart {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    display: none;
  }

  .lineart path {
    fill: none;
    stroke-width: 7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .lineart__hill {
    stroke: var(--green);
  }

  .lineart__wave {
    stroke: var(--navy);
  }

  /* Enhanced only: the lines draw, then give way to the real icon. */
  :global(.journey.is-enhanced) .lineart {
    display: block;
  }

  :global(.journey.is-enhanced) .lineart path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  :global(.journey.is-enhanced .is-drawn) .lineart {
    opacity: 0;
    transition: opacity 0.5s var(--ease) 1.7s;
  }

  :global(.journey.is-enhanced .is-drawn) .lineart path {
    stroke-dashoffset: 0;
  }

  :global(.journey.is-enhanced .is-drawn) .lineart__hill {
    transition: stroke-dashoffset 1.1s var(--ease) calc(var(--i) * 0.15s);
  }

  :global(.journey.is-enhanced .is-drawn) .lineart__wave {
    transition: stroke-dashoffset 0.9s var(--ease) calc(0.5s + var(--i) * 0.15s);
  }
</style>
