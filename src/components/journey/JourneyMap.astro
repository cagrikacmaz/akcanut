---
// Two stacked maps built by scripts/build-journey-map.mjs: a close view of the Black Sea
// coast for the steps at origin, and a wide view from Türkiye to Kenya for the last step.
// Place and area names are HTML so they stay readable at any map scale.
import { getDictionary, type Locale } from '../../i18n';
import data from './map-data.json';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);

type PlaceKey = keyof typeof t.journey.places;
type AreaKey = keyof typeof t.journey.areas;
type Side = 'left' | 'right' | 'above';

const views = [
  {
    key: 'regional',
    view: data.regional,
    sides: { istanbul: 'above', akcakoca: 'above' } as Record<string, Side>,
  },
  {
    key: 'continental',
    view: data.continental,
    sides: { istanbul: 'left', akcakoca: 'right', nairobi: 'left', mombasa: 'right' } as Record<string, Side>,
  },
] as const;

const pct = (value: number) => `${(value * 100).toFixed(3)}%`;
// Uppercase labels need Turkish casing rules to keep the dotted İ in TÜRKİYE.
const langFor = (text: string) => (text === 'Türkiye' ? 'tr' : undefined);
---

<div class="jmap-wrap" role="img" aria-label={t.journey.mapLabel}>
  {
    views.map(({ key, view, sides }) => {
      const [, , w, h] = view.viewBox;
      const routes = view.routes as { road: string; air?: string; sea?: string };
      return (
        <div class={`jmap jmap--${key}`}>
          <div class="jmap__frame" data-map={key} style={`--ratio: ${(w / h).toFixed(5)}`}>
            <svg class="jmap__svg" viewBox={view.viewBox.join(' ')} preserveAspectRatio="xMidYMid meet" focusable="false">
              {routes.air && routes.sea && (
                <defs>
                  <mask id="jmap-reveal-air" maskUnits="userSpaceOnUse" x={-w} y={-h} width={w * 3} height={h * 3}>
                    <path class="jmap__reveal jmap__reveal--air" d={routes.air} pathLength="1" />
                  </mask>
                  <mask id="jmap-reveal-sea" maskUnits="userSpaceOnUse" x={-w} y={-h} width={w * 3} height={h * 3}>
                    <path class="jmap__reveal jmap__reveal--sea" d={routes.sea} pathLength="1" />
                  </mask>
                </defs>
              )}
              <path class="jmap__grid" d={view.graticule} />
              <path class="jmap__land" d={view.land} />
              <path class="jmap__route jmap__route--road" d={routes.road} pathLength="1" />
              {routes.air && <path class="jmap__route jmap__route--air" d={routes.air} mask="url(#jmap-reveal-air)" />}
              {routes.sea && <path class="jmap__route jmap__route--sea" d={routes.sea} mask="url(#jmap-reveal-sea)" />}
            </svg>

            {Object.entries(view.labels).map(([area, [x, y]]) => {
              const text = t.journey.areas[area as AreaKey];
              return (
                <span
                  class:list={['jmap__area', `jmap__area--${area}`]}
                  lang={langFor(text)}
                  style={`left: ${pct(x / w)}; top: ${pct(y / h)}`}
                >
                  {text}
                </span>
              );
            })}

            {Object.entries(view.places).map(([place, [x, y]]) => (
              <span
                class:list={['jmap__place', `jmap__place--${place}`]}
                data-place={place}
                data-side={sides[place]}
                data-x={(x / w).toFixed(5)}
                data-y={(y / h).toFixed(5)}
                style={`left: ${pct(x / w)}; top: ${pct(y / h)}`}
              >
                <span class="jmap__dot" />
                <span class="jmap__name">{t.journey.places[place as PlaceKey]}</span>
              </span>
            ))}
          </div>
        </div>
      );
    })
  }

  <ul class="jmap__legend">
    <li class="jmap__key jmap__key--road">
      <svg viewBox="0 0 28 8" aria-hidden="true"><path d="M1 4h26"></path></svg>
      {t.journey.legend.road}
    </li>
    <li class="jmap__key jmap__key--air">
      <svg viewBox="0 0 28 8" aria-hidden="true"><path d="M1 4h26"></path></svg>
      {t.journey.legend.air}
    </li>
    <li class="jmap__key jmap__key--sea">
      <svg viewBox="0 0 28 8" aria-hidden="true"><path d="M2 4h24"></path></svg>
      {t.journey.legend.sea}
    </li>
  </ul>
</div>

<style>
  .jmap-wrap {
    position: absolute;
    inset: 0;
  }

  .jmap {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    container-type: size;
  }

  .jmap__frame {
    position: relative;
    width: 100%;
    width: min(100cqw, calc(100cqh * var(--ratio)));
    aspect-ratio: var(--ratio);
  }

  .jmap__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .jmap__grid {
    fill: none;
    stroke: var(--map-grid);
    stroke-width: 0.8;
  }

  .jmap__land {
    fill: var(--map-land);
    stroke: var(--map-coast);
    stroke-width: 0.9;
    stroke-linejoin: round;
  }

  .jmap__route {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .jmap__route--road {
    stroke: var(--brown);
    stroke-width: 3.2;
  }

  .jmap--continental .jmap__route--road {
    stroke-width: 3;
  }

  .jmap__route--air {
    stroke: var(--brown);
    stroke-width: 2.6;
    stroke-dasharray: 10 8;
  }

  .jmap__route--sea {
    stroke: var(--navy);
    stroke-width: 3.4;
    stroke-dasharray: 0.1 8;
  }

  .jmap__reveal {
    fill: none;
    stroke: #fff;
    stroke-width: 16;
    stroke-linecap: round;
  }

  /* Places and areas */

  .jmap__place {
    position: absolute;
    width: 0;
    height: 0;
  }

  .jmap__dot {
    position: absolute;
    left: -6px;
    top: -6px;
    width: 12px;
    height: 12px;
    border: 2px solid var(--navy);
    border-radius: 50%;
    background: var(--paper-light);
  }

  .jmap__place--istanbul .jmap__dot,
  .jmap__place--nairobi .jmap__dot,
  .jmap__place--mombasa .jmap__dot {
    background: var(--navy);
  }

  .jmap__place--akcakoca .jmap__dot {
    border-color: var(--brown);
    background: var(--brown);
  }

  .jmap__place--akcakoca .jmap__dot::after {
    content: '';
    position: absolute;
    inset: -2px;
    border: 2px solid var(--brown);
    border-radius: 50%;
    opacity: 0;
  }

  .jmap__name {
    position: absolute;
    padding: 0.15rem 0.35rem;
    border-radius: 4px;
    background: rgb(251 250 246 / 0.85);
    color: var(--deep);
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
    white-space: nowrap;
  }

  [data-side='right'] .jmap__name {
    top: 0;
    left: 10px;
    transform: translateY(-50%);
  }

  [data-side='left'] .jmap__name {
    top: 0;
    right: 10px;
    transform: translateY(-50%);
  }

  [data-side='above'] .jmap__name {
    bottom: 10px;
    left: 0;
    transform: translateX(-50%);
  }

  .jmap__area {
    position: absolute;
    transform: translate(-50%, -50%);
    color: #3b5467;
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.2em;
    line-height: 1.2;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .jmap__area--turkiye,
  .jmap__area--kenya {
    color: #5a5750;
    font-weight: 700;
    letter-spacing: 0.26em;
  }

  /* Legend */

  .jmap__legend {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    display: grid;
    gap: 0.3rem;
    padding: 0.6rem 0.8rem;
    border-radius: var(--radius-sm);
    background: rgb(251 250 246 / 0.9);
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--ink);
  }

  .jmap__key {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .jmap__key svg {
    width: 28px;
    height: 8px;
    overflow: visible;
    fill: none;
    stroke-linecap: round;
  }

  .jmap__key--road svg {
    stroke: var(--brown);
    stroke-width: 2.4;
  }

  .jmap__key--air svg {
    stroke: var(--brown);
    stroke-width: 2;
    stroke-dasharray: 6 4;
  }

  .jmap__key--sea svg {
    stroke: var(--navy);
    stroke-width: 3;
    stroke-dasharray: 0.1 5.5;
  }

  /*
   * Static version (no JavaScript or reduced motion): the wide map only,
   * every route drawn. The enhanced states below are applied by src/scripts/journey.ts.
   */

  .jmap--regional {
    display: none;
  }

  /* Inset so labels at the edge of the wide map are never cut off. */
  :global(.journey:not(.is-enhanced)) .jmap {
    padding: 1.5rem 3rem;
  }

  :global(.journey.is-enhanced) .jmap--regional {
    display: grid;
  }

  :global(.journey.is-enhanced) .jmap {
    transition: opacity 0.9s var(--ease);
  }

  :global(.journey.is-enhanced[data-step='0']) .jmap--regional,
  :global(.journey.is-enhanced) .jmap--continental {
    opacity: 0;
  }

  :global(.journey.is-enhanced[data-step='7']) .jmap--regional {
    opacity: 0;
    transition-duration: 0.8s;
  }

  :global(.journey.is-enhanced[data-step='7']) .jmap--continental {
    opacity: 1;
    transition-delay: 0.1s;
  }

  /*
   * Phones and tablets: the step cards sit low on the screen, so the maps keep to the
   * upper part of the stage and the wide map is sized to end above the last card.
   */
  @media (max-width: 59.99rem) {
    :global(.journey.is-enhanced) .jmap {
      place-items: start center;
      padding-top: 3.75rem;
    }

    /* --card-space is the height of the last card, measured by src/scripts/journey.ts. */
    :global(.journey.is-enhanced) .jmap--continental .jmap__frame {
      width: min(100cqw, calc((100cqh - var(--card-space, 40cqh)) * var(--ratio)));
    }

    :global(.journey.is-enhanced) .jmap__legend {
      display: none;
    }
  }

  /* Zoom out: the close view shrinks into its place on the wide map. */
  :global(.journey.is-enhanced) .jmap--regional .jmap__frame {
    transform-origin: 0 0;
    transition: transform 1.1s var(--ease-out);
  }

  :global(.journey.is-enhanced[data-step='7']) .jmap--regional .jmap__frame {
    transform: translate(var(--zoom-x, 0px), var(--zoom-y, 0px)) scale(var(--zoom-s, 1));
  }

  /* Routes draw in order: to Istanbul at step 6, then air and sea at step 7. */
  :global(.journey.is-enhanced) .jmap__route--road,
  :global(.journey.is-enhanced) .jmap__reveal {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.6s var(--ease);
  }

  :global(.journey.is-enhanced:is([data-step='6'], [data-step='7'])) .jmap__route--road {
    stroke-dashoffset: 0;
    transition-duration: 1.3s;
  }

  :global(.journey.is-enhanced[data-step='7']) .jmap--continental .jmap__route--road {
    transition-duration: 0s;
  }

  :global(.journey.is-enhanced[data-step='7']) .jmap__reveal--air {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1.5s var(--ease) 1s;
  }

  :global(.journey.is-enhanced[data-step='7']) .jmap__reveal--sea {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 2.2s var(--ease) 2.2s;
  }

  /* Istanbul fills in once the line from Akçakoca arrives. */
  :global(.journey.is-enhanced) .jmap--regional .jmap__place--istanbul .jmap__dot {
    background: var(--paper-light);
    transition: background-color 0.4s var(--ease);
  }

  :global(.journey.is-enhanced:is([data-step='6'], [data-step='7'])) .jmap--regional .jmap__place--istanbul .jmap__dot {
    background: var(--navy);
    transition-delay: 1.1s;
  }

  /* Nairobi and Mombasa appear as their routes arrive. */
  :global(.journey.is-enhanced) .jmap--continental .jmap__place--nairobi,
  :global(.journey.is-enhanced) .jmap--continental .jmap__place--mombasa {
    opacity: 0;
    transition: opacity 0.5s var(--ease);
  }

  :global(.journey.is-enhanced[data-step='7']) .jmap--continental .jmap__place--nairobi {
    opacity: 1;
    transition-delay: 2.3s;
  }

  :global(.journey.is-enhanced[data-step='7']) .jmap--continental .jmap__place--mombasa {
    opacity: 1;
    transition-delay: 4.2s;
  }

  /* Akçakoca pulses once for each step that happens at origin. */
  :global(.journey.is-enhanced:is([data-step='1'], [data-step='3'], [data-step='5']))
    .jmap--regional
    .jmap__place--akcakoca
    .jmap__dot::after {
    animation: jmap-pulse-a 1.6s var(--ease-out) 0.3s both;
  }

  :global(.journey.is-enhanced:is([data-step='2'], [data-step='4']))
    .jmap--regional
    .jmap__place--akcakoca
    .jmap__dot::after {
    animation: jmap-pulse-b 1.6s var(--ease-out) 0.3s both;
  }

  @keyframes jmap-pulse-a {
    from {
      opacity: 0.9;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(3.4);
    }
  }

  @keyframes jmap-pulse-b {
    from {
      opacity: 0.9;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(3.4);
    }
  }

  /* The legend grows with the route: one line at step 6, all three at step 7. */
  :global(.journey.is-enhanced) .jmap__legend {
    opacity: 0;
    transition: opacity 0.5s var(--ease);
  }

  :global(.journey.is-enhanced:is([data-step='6'], [data-step='7'])) .jmap__legend {
    opacity: 1;
  }

  :global(.journey.is-enhanced:not([data-step='7'])) .jmap__key--air,
  :global(.journey.is-enhanced:not([data-step='7'])) .jmap__key--sea {
    display: none;
  }

  :global(.journey.is-enhanced[data-step='7']) .jmap__key--air {
    animation: jmap-key-in 0.5s var(--ease) 1s both;
  }

  :global(.journey.is-enhanced[data-step='7']) .jmap__key--sea {
    animation: jmap-key-in 0.5s var(--ease) 2.2s both;
  }

  @keyframes jmap-key-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
