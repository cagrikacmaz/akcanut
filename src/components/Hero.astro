---
import { Picture } from 'astro:assets';
import logo from '../assets/brand/akcanut-logo.png';
import { getDictionary, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__inner container">
    <Picture
      src={logo}
      alt={t.hero.logoAlt}
      widths={[220, 330, 440, 560]}
      sizes="(min-width: 60rem) 280px, 220px"
      formats={['avif', 'webp']}
      priority
      class="hero__logo"
    />
    <h1 id="hero-title" class="hero__title">{t.hero.title}</h1>
    <p class="hero__lead lead">{t.hero.lead}</p>
    <div class="hero__actions">
      <a class="btn btn--primary" href="#journey">{t.hero.ctaOrigin}</a>
      <a class="btn btn--secondary" href="#trade">{t.hero.ctaTrade}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    min-height: calc(100svh - var(--header-h));
    padding-block: clamp(2.5rem, 1.5rem + 5vw, 5rem);
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .hero__logo {
    width: 220px;
    height: auto;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .hero__title {
    max-width: 12ch;
    font-size: var(--text-h1);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .hero__lead {
    max-width: 30ch;
    margin-top: 1.25rem;
    color: var(--ink);
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: min(100%, 20rem);
    margin-top: 2.25rem;
  }

  @media (min-width: 40rem) {
    .hero__actions {
      flex-direction: row;
      justify-content: center;
      width: auto;
    }
  }

  @media (min-width: 60rem) {
    .hero {
      min-height: calc(92svh - var(--header-h));
    }

    .hero__logo {
      width: 280px;
    }
  }
</style>
