---
// Globe button in the header that opens a short list of languages, each in its own name.
// On the English page it also holds a hint for visitors whose browser prefers Turkish or
// Swahili; src/scripts/language.ts decides whether to show it. Nothing ever redirects.
import { availableLocales, defaultLocale, getDictionary, languageNames, localePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const others = availableLocales.filter((l) => l !== locale);
---

{
  availableLocales.length > 1 && (
    <div class="lang" data-lang>
      <button
        class="lang__button"
        type="button"
        aria-expanded="false"
        aria-controls="lang-menu"
        aria-label={t.a11y.changeLanguage}
        title={t.a11y.changeLanguage}
        data-lang-toggle
      >
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="9" />
          <path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9M12 3C9.5 5.6 8.2 8.6 8.2 12s1.3 6.4 3.8 9" />
        </svg>
      </button>

      <ul class="lang__menu" id="lang-menu" hidden data-lang-menu>
        {availableLocales.map((l) => (
          <li>
            <a
              href={localePath(l)}
              hreflang={l}
              lang={l}
              aria-current={l === locale ? 'true' : undefined}
              data-lang-link
            >
              {languageNames[l]}
              {l === locale && (
                <svg class="lang__check" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                  <path d="m5 12.5 4.5 4.5L19 7.5" />
                </svg>
              )}
            </a>
          </li>
        ))}
      </ul>

      {locale === defaultLocale &&
        others.map((l) => {
          const d = getDictionary(l);
          return (
            <p class="lang__hint" lang={l} hidden data-lang-hint={l}>
              <a href={localePath(l)} hreflang={l} data-lang-link data-lang-hint-link>
                {d.a11y.viewInLanguage}
              </a>
              <button class="lang__hint-close" type="button" aria-label={d.a11y.menuClose} data-lang-hint-close>
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                  <path d="m6 6 12 12M18 6 6 18" />
                </svg>
              </button>
            </p>
          );
        })}
    </div>
  )
}

<script>
  import '../scripts/language';
</script>

<style>
  .lang {
    position: relative;
  }

  .lang__button {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--paper-light);
    color: var(--deep);
    cursor: pointer;
    transition:
      border-color 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }

  .lang__button:hover,
  .lang__button[aria-expanded='true'] {
    border-color: var(--deep);
  }

  .lang svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .lang__menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    z-index: 60;
    min-width: 11rem;
    margin: 0;
    padding: 0.4rem;
    list-style: none;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--paper-light);
    box-shadow: 0 16px 32px -20px rgb(6 51 33 / 0.45);
  }

  .lang__menu a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.75rem;
    padding: 0 0.75rem;
    border-radius: 6px;
    color: var(--ink);
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
  }

  .lang__menu a:hover {
    background: var(--paper-deep);
  }

  .lang__menu a[aria-current='true'] {
    color: var(--deep);
  }

  .lang__check {
    color: var(--brown);
  }

  .lang__hint {
    position: absolute;
    top: calc(100% + 0.6rem);
    right: 0;
    z-index: 55;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0.35rem 0.35rem 0.35rem 0.9rem;
    border-radius: 999px;
    background: var(--deep);
    box-shadow: 0 12px 24px -16px rgb(6 51 33 / 0.6);
    white-space: nowrap;
  }

  .lang__hint[hidden] {
    display: none;
  }

  /* Small pointer towards the globe */
  .lang__hint::before {
    content: '';
    position: absolute;
    top: -5px;
    right: 1rem;
    width: 10px;
    height: 10px;
    background: var(--deep);
    transform: rotate(45deg);
  }

  .lang__hint a {
    position: relative;
    color: var(--paper);
    font-size: 0.875rem;
    font-weight: 700;
  }

  .lang__hint-close {
    position: relative;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--paper);
    cursor: pointer;
  }

  .lang__hint :focus-visible {
    outline-color: var(--gold);
  }

</style>
